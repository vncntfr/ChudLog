# ChudLog private v1 — environment template.
# Copy to .env and fill. NEVER commit the real .env (session material, VAPID private key).

# --- core ---
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
DB_PATH=./data/chudlog.db

# Origin the app is published under (CORS/CSRF-allowed, push deep-link base)
PUBLIC_ORIGIN=http://127.0.0.1:8787
# Extra origins for local dev (Vite dev server proxy/origin); comma-separated
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- auth ---
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=CHANGE_ME

# --- web push (RFC 8292 VAPID — generate once: npm --workspace api run vapid:gen) ---
# VAPID_PUBLIC_KEY is exposed to the frontend (Base64URL, never the private key).
VAPID_PUBLIC_KEY=
# private key never leaves the server:
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@localhost
VAPID_SUB=mailto:admin@localhost

# --- operational ---
# Comma-separated emails allowed to /api/admin/* (private: admin-assisted reset)
ADMIN_EMAILS=
